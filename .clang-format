# Formatting for StratChessEvolved. See issue #175.
BasedOnStyle:  LLVM
Language:      Cpp
Standard:      c++20
UseTab:        ForIndentation
TabWidth:      4
IndentWidth:   4
ColumnLimit:   100
IndentCaseLabels: false
NamespaceIndentation: None
PointerAlignment:   Left
ReferenceAlignment: Pointer
AllowShortFunctionsOnASingleLine: Empty
# Include order carries meaning here: StdAfx.h must precede the headers that rely
# on it. Reordering includes is a semantic change, not formatting.
SortIncludes:  Never
IncludeBlocks: Preserve
# LLVM's default (None) would flatten the nested _MSC_VER branches in Compat.h,
# StdAfx.h, SquareHelper.h and PieceHelper.h to column zero.
IndentPPDirectives: AfterHash
# LineEnding is deliberately left at its default (derive from the file). Git stores
# LF and checks out CRLF on Windows via `* text=auto`; pinning LF here would make
# the local format check fail against every CRLF working-tree file.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction:         true
  AfterClass:            false
  AfterStruct:           false
  AfterUnion:            false
  AfterEnum:             false
  AfterNamespace:        false
  AfterCaseLabel:        false
  AfterControlStatement: Never
  BeforeElse:            false
  BeforeCatch:           false
  BeforeWhile:           false
  BeforeLambdaBody:      false
  IndentBraces:          false
  SplitEmptyFunction:    false
  SplitEmptyRecord:      false
  SplitEmptyNamespace:   false
