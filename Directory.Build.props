<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Automatically imported by MSBuild for every project in this repository,
    including projects built from git worktrees.

    WORKTREE BUILDS: Git worktrees live at .claude/worktrees/<name>/ — three
    directory levels below the repository root.  MSBuild finds this file at the
    worktree root before reaching the main repo root, so $(MSBuildThisFileDirectory)
    resolves to the worktree directory instead of the repo root.  We detect this
    by checking whether StratChessEvolved.sln exists three levels up (true only
    from inside a worktree) and compute DepsRoot accordingly — no per-worktree
    setup required.

    $(DepsRoot) — folder that CONTAINS the json/ and spdlog/ dependency
                  directories.  Default: the parent of this repo, which assumes
                  json/ and spdlog/ are checked out as siblings of
                  StratChessEvolved/.  Override in Directory.Build.user.props
                  for non-standard layouts (see Directory.Build.user.props.example).

    USER OVERRIDES (Directory.Build.user.props — gitignored, never committed):
      • Place it next to this file for a per-location override.
      • When building from a worktree, a user.props at the main repo root is
        also imported automatically if no worktree-local one exists, so one
        file in the repo root covers every worktree on that machine.
  -->

  <!-- Per-machine overrides — not committed to git.
       Worktree fallback: if no local user.props exists here, inherit the one
       at the main repo root (3 levels up) so a single file covers all worktrees. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\StratChessEvolved.sln') AND
                     !Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props') AND
                     Exists('$(MSBuildThisFileDirectory)..\..\..\Directory.Build.user.props')" />

  <PropertyGroup>
    <!-- Detect worktree context: StratChessEvolved.sln at 3 levels up means we are
         inside .claude/worktrees/<name>/ — DepsRoot is then 4 levels up (repo parent).
         From the repo root directly, DepsRoot is 1 level up as usual. -->
    <DepsRoot Condition="'$(DepsRoot)' == '' AND
                         Exists('$(MSBuildThisFileDirectory)..\..\..\StratChessEvolved.sln')">$(MSBuildThisFileDirectory)..\..\..\..\</DepsRoot>
    <DepsRoot Condition="'$(DepsRoot)' == ''">$(MSBuildThisFileDirectory)..\</DepsRoot>
  </PropertyGroup>
</Project>
