{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) 'Scripts/Invoke-SkillGate.ps1')\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
