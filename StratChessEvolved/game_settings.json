{
  "game": {
    /* type (PlayerType in StratEngine/PlayerFactory.h): 0 = Human, 1 = Search (AIPerplex).
       Absent defaults to 1; any other value is rejected at game start. */
    "players": {
      "white": {
        "type": 1,
        /* search_limits: per-move search constraints, mirrors StratEngine/SearchLimits.h.
           Required for a Search player. Every field is optional: depth (cap), movetime (ms,
           soft==hard budget), infinite (bool), clock { remaining, increment, moves_to_go } */
        "search_limits": {
          "depth": 15,
          "movetime": 15000
        },
        /* search_tuning (optional, Search player only): any key from
           StratEngine/SearchTuning.def, which lists them with their defaults and accepted
           ranges. A value of the wrong type or out of range stops the game with a message
           naming the key. Example: "search_tuning": { "lmr_enabled": false } */
        /* threads: Lazy SMP search thread count (default 1). */
        "threads": 1
      },
      "black": {
        "type": 1,
        "search_limits": {
          "depth": 15,
          "movetime": 15000
        },
        "threads": 1
      }
    },

    /* Starting position. Absent or empty means the standard opening position. */
    "FEN": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"

    /* Alternative FEN positions:
       "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1"
       "5k2/ppp5/4P3/3R3p/6P1/1K2Nr2/PP3P2/8 b - - 1 32"
       "4k3/8/8/8/8/8/4P3/4K3 w - - 5 39"
       "5B2/8/8/4RPpk/4pK1N/6P1/4qP2/8 w - g6 0 1" mate in one
    */
  }
}
