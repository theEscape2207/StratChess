# clangd config. The compilation database is generated by the shipping clang-cl
# preset, so the tree must be built once before clangd can resolve headers.
CompileFlags:
  CompilationDatabase: build/windows-clang-cl

---
# StratEngine/Archived/ is excluded from the build and has no compile commands.
If:
  PathMatch: .*/Archived/.*
Diagnostics:
  Suppress: '*'
