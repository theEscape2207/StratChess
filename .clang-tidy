# Fast Gate profile used by local PrePR validation and required PR CI.
# Analyzer checks and exception-escape analysis run in the Deep Nightly profile.
# misc-include-cleaner stays off on purpose: it contradicts the Common.h umbrella convention (#281).
# bugprone-signed-bitwise (LLVM 23+, a rename of hicpp-signed-bitwise) is excluded: bitboard code uses signed bitwise ops deliberately; no defect in a 20-site sample (#475).
Checks: >
  -*,
  bugprone-*,
  performance-*,
  misc-const-correctness,
  misc-use-anonymous-namespace,
  -bugprone-throwing-static-initialization,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-signed-bitwise,
  -clang-analyzer-*
WarningsAsErrors: '*'
# Our sources only. ExcludeHeaderFilterRegex is required as well: HeaderFilterRegex
# alone still let two findings through from vendored Catch2 under build/_deps.
HeaderFilterRegex: '.*(StratEngine|StratChessEvolved|StratChessTests)[\\/].*'
ExcludeHeaderFilterRegex: '.*[\\/]_deps[\\/].*'
FormatStyle: file
CheckOptions:
  performance-enum-size.EnumIgnoreList: >-
    eRowNames;eSquare;GameValues;AIPerplex::IterationDecision;AIPerplex::RejectionReason;GameStates;PlayerType;FenBatch::LineKind
