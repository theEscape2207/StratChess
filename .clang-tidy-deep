# Analyzer-heavy checks run only in failing Nightly jobs.
# misc-include-cleaner stays off on purpose: it contradicts the StdAfx.h umbrella convention (#281).
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-exception-escape
WarningsAsErrors: '*'
HeaderFilterRegex: '.*(StratEngine|StratChessEvolved)[\\/].*'
ExcludeHeaderFilterRegex: '.*[\\/]_deps[\\/].*'
FormatStyle: file
